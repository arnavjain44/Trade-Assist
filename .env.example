# Trade-Assist Environment Configuration Template
# Copy this file to .env and configure your local settings.
# DO NOT commit real secrets or credentials to version control.

# Application Settings
PROJECT_NAME="AI Intraday Trading Web App API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# LLM Providers (Optional for historical data acquisition)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Knowledge Graph (Neo4j)
NEO4J_URI=""
NEO4J_USER=""
NEO4J_PASSWORD=""

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIR="./chroma_db"

# Historical Data Acquisition (Phase 5.4)
# Supported providers: "kite", "truedata", "local_csv", "yfinance"
HISTORICAL_DATA_PROVIDER="kite"
HISTORICAL_DATA_API_KEY=""
HISTORICAL_DATA_API_SECRET=""
HISTORICAL_DATA_ACCESS_TOKEN=""

# Historical Storage Paths
HISTORICAL_DATA_RAW_DIR="data/raw/historical"
HISTORICAL_DATA_CLEAN_DIR="data/processed/historical"
